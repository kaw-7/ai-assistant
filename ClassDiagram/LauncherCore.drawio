        <mxCell id="t3" value="Where a run crosses the process boundary" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="30" y="16" width="560" height="24" as="geometry" />
        </mxCell>
        <mxCell id="t3s" value="One child process per run - clean configuration state, output streamed back through a queue." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="30" y="42" width="700" height="18" as="geometry" />
        </mxCell>
        <mxCell id="laneL" value="LAUNCHER PROCESS" style="swimlane;html=1;startSize=30;horizontal=1;whiteSpace=wrap;fillColor=none;dashed=1;dashPattern=6 6;strokeWidth=1;" parent="1" vertex="1">
          <mxGeometry x="20" y="80" width="390" height="780" as="geometry" />
        </mxCell>
        <mxCell id="L1" value="&lt;b&gt;LauncherApp (Tk)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;ui/app.py - module list + config editor&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;arcSize=8;" parent="laneL" vertex="1">
          <mxGeometry x="20" y="50" width="350" height="50" as="geometry" />
        </mxCell>
        <mxCell id="L2" value="&lt;b&gt;SettingsStore.as_dict()&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;{source_id: {key: value}}&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;stored + volatile (secrets) merged&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;arcSize=8;" parent="laneL" vertex="1">
          <mxGeometry x="20" y="140" width="350" height="60" as="geometry" />
        </mxCell>
        <mxCell id="L3" value="&lt;b&gt;ProcessRunner.start(id, overrides)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;writes %TEMP%/launcher_cfg_*.json&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;subprocess.Popen - CREATE_NO_WINDOW&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;arcSize=8;" parent="laneL" vertex="1">
          <mxGeometry x="20" y="250" width="350" height="60" as="geometry" />
        </mxCell>
        <mxCell id="L4" value="&lt;b&gt;reader thread -&gt; queue&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;MSG_OUTPUT / MSG_STATUS / MSG_FINISHED&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;4 KiB chunks, incremental utf-8 decode&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;arcSize=8;" parent="laneL" vertex="1">
          <mxGeometry x="20" y="560" width="350" height="60" as="geometry" />
        </mxCell>
        <mxCell id="L5" value="&lt;b&gt;LauncherApp._drain_queue()&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;polled from the Tk main loop&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;arcSize=8;" parent="laneL" vertex="1">
          <mxGeometry x="20" y="670" width="350" height="50" as="geometry" />
        </mxCell>
        <mxCell id="laneR" value="CHILD PROCESS - one per run" style="swimlane;html=1;startSize=30;horizontal=1;whiteSpace=wrap;fillColor=none;dashed=1;dashPattern=6 6;strokeWidth=1;" parent="1" vertex="1">
          <mxGeometry x="430" y="80" width="390" height="780" as="geometry" />
        </mxCell>
        <mxCell id="R1" value="&lt;b&gt;child_main.main(id, json)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;ensure_project_root_on_path()&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;use_project_root_as_cwd()&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;arcSize=8;" parent="laneR" vertex="1">
          <mxGeometry x="20" y="250" width="350" height="60" as="geometry" />
        </mxCell>
        <mxCell id="R2" value="&lt;b&gt;ModuleRegistry().discover() -&gt; get(id)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;discovery errors printed, never raised&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;arcSize=8;" parent="laneR" vertex="1">
