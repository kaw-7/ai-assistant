  <diagram name="3 - Run path" id="LauncherCorePage3">
    <mxGraphModel dx="963" dy="659" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
